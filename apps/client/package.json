{
  "name": "@grimoire/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @grimoire/shared build && pnpm --filter @grimoire/domain build && pnpm --filter @grimoire/vault build && pnpm --filter @grimoire/state build && pnpm --filter @grimoire/reader build && pnpm --filter @grimoire/ui build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@grimoire/domain": "workspace:*",
    "@grimoire/reader": "workspace:*",
    "@grimoire/shared": "workspace:*",
    "@grimoire/state": "workspace:*",
    "@grimoire/ui": "workspace:*",
    "@grimoire/vault": "workspace:*",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
