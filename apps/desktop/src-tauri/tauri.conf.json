{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Grimoire",
  "version": "1.0.0",
  "identifier": "com.grimoire.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @grimoire/client dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @grimoire/client build",
    "frontendDist": "../../apps/client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimoire",
        "width": 1420,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
