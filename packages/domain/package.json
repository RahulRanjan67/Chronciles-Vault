{
  "name": "@chronicles-vault/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure domain model for Chronicles Vault — entities, value objects, repository interfaces, domain events",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/health-scheduler.test.ts tests/merge-archive.test.ts tests/work-relations.test.ts"
  },
  "dependencies": {
    "@chronicles-vault/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
